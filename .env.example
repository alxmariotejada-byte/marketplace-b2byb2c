# Copia este archivo como .env.local para trabajar en tu computadora.
# En Vercel, agrega estas mismas variables en Settings → Environment Variables.

# Cadena de conexión de Neon (Dashboard de Neon → Connect → copia la "Pooled connection")
DATABASE_URL=postgresql://usuario:clave@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Contraseña para entrar al panel /admin
ADMIN_PASSWORD=cambia-esta-clave

# Conexión con el ERP/OMS de LOGIMKT (opcional). Sin estas variables la tienda usa su inventario propio.
# URL de la API del ERP (o el enlace de Vercel del ERP, que reenvía /api a la API)
ERP_API_URL=https://marketplaceerp-api.onrender.com
# Usuario del ERP con rol Comprador: crea los pedidos en el OMS del ERP.
ERP_EMAIL=
ERP_PASSWORD=
# (Opcional) Usuario Admin del ERP: al sincronizar trae también stock disponible y precio B2B.
ERP_ADMIN_EMAIL=
ERP_ADMIN_PASSWORD=
