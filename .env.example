# Copia este archivo como .env.local para trabajar en tu computadora.
# En Vercel, agrega estas mismas variables en Settings → Environment Variables.

# Cadena de conexión de Neon (Dashboard de Neon → Connect → copia la "Pooled connection")
DATABASE_URL=postgresql://usuario:clave@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Contraseña para entrar al panel /admin
ADMIN_PASSWORD=cambia-esta-clave
